# Production environment variables.
# Copy to your hosting provider (e.g. Vercel project Settings -> Environment Variables)
# as-is. These are PUBLIC values (Supabase anon key is safe for browsers).
#
# Without these the app runs in local demo mode; with them it connects to Supabase.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key